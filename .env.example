# Firebase Configuration
# Get these values from Firebase Console → Project Settings → Your Apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_ELDER_ID=demo-resident

# Backend API (Express server)
VITE_API_URL=http://localhost:5000

# n8n AI Workflow Webhook
# After importing n8n/VitalCare-AI-Elder-Care-Monitoring.json into n8n Cloud,
# copy the webhook URL from the "Receive Resident Health Data" node and paste it here.
# Example: https://<your-subdomain>.app.n8n.cloud/webhook/vitalcare-ai
VITE_N8N_WEBHOOK_URL=https://<your-n8n-cloud-webhook>/webhook/vitalcare-ai

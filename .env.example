# ==============================================================================
# VitalCare Elder Care Monitoring System - Environment Configuration
# ==============================================================================

# --- Firebase Configuration (Required for Production & Vercel) ---
# Retrieve from: Firebase Console -> Project Settings -> General -> Your Apps
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_FIREBASE_ELDER_ID=demo-resident

# --- AI Insights & Workflow Automation ---
# Connects to your hosted n8n Cloud AI agent workflow
VITE_N8N_WEBHOOK_URL=https://<your-subdomain>.app.n8n.cloud/webhook/vitalcare-ai

# --- Local Camera Gateway / Edge Streamer (Optional) ---
# Smartwatches, health vitals, reminders, reports, and routines run serverlessly on Firestore.
# The camera streaming service (ONVIF, RTSP, FFmpeg HLS) requires native network socket access
# and runs on your local edge machine (or tunnel via ngrok / Cloudflare).
# In local development: http://localhost:5000
# In production on Vercel: https://your-camera-tunnel.ngrok-free.app or leave empty if cameras not active.
VITE_CAMERA_API_URL=http://localhost:5000

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function userExists(uid) {
      return exists(userPath(uid));
    }

    function userData(uid) {
      return get(userPath(uid)).data;
    }

    function role() {
      return signedIn() && userExists(request.auth.uid)
        ? userData(request.auth.uid).role
        : null;
    }

    function isAdmin() {
      return role() == 'admin';
    }

    function isCaregiver() {
      return role() == 'caregiver'
        && (!('status' in userData(request.auth.uid))
          || userData(request.auth.uid).status == 'active');
    }

    function isElder() {
      return role() == 'elder';
    }

    function elderIdPath(elderId) {
      return /databases/$(database)/documents/elderIds/$(elderId);
    }

    function isActiveElderId(elderId, elderUid) {
      let idPath = elderIdPath(elderId);
      let profilePath = userPath(elderUid);
      return exists(idPath)
        && exists(profilePath)
        && get(idPath).data.elderUid == elderUid
        && get(idPath).data.elderId == elderId
        && get(idPath).data.status == 'active'
        && get(profilePath).data.role == 'elder'
        && get(profilePath).data.elderId == elderId
        && (!('status' in get(profilePath).data)
          || get(profilePath).data.status == 'active');
    }

    function ownsElderIdAfter(uid, elderId) {
      let path = elderIdPath(elderId);
      return existsAfter(path)
        && getAfter(path).data.elderUid == uid
        && getAfter(path).data.elderId == elderId;
    }

    function relationshipPath(caregiverUid, elderId) {
      return /databases/$(database)/documents/relationships/$(('rel-' + caregiverUid + '-' + elderId));
    }

    function hasActiveCaregiverRelationship(caregiverUid, elderUid, elderId) {
      let path = relationshipPath(caregiverUid, elderId);
      return exists(path)
        && get(path).data.caregiverUid == caregiverUid
        && get(path).data.elderUid == elderUid
        && get(path).data.elderId == elderId
        && get(path).data.status == 'active'
        && isActiveElderId(elderId, elderUid);
    }

    function canAccessElder(elderId) {
      return isAdmin()
        || (signedIn()
          && isElder()
          && userData(request.auth.uid).elderId == elderId
          && isActiveElderId(elderId, request.auth.uid))
        || (signedIn()
          && isCaregiver()
          && hasActiveCaregiverRelationship(
            request.auth.uid,
            get(elderIdPath(elderId)).data.elderUid,
            elderId
          ));
    }

    function canCaregiverAccessElderUser(targetUid, targetUserData) {
      return isCaregiver()
        && targetUserData.role == 'elder'
        && 'elderId' in targetUserData
        && hasActiveCaregiverRelationship(
          request.auth.uid,
          targetUid,
          targetUserData.elderId
        );
    }

    function canElderAccessCaregiverUser(targetCaregiverUid) {
      return isElder()
        && 'elderId' in userData(request.auth.uid)
        && hasActiveCaregiverRelationship(
          targetCaregiverUid,
          request.auth.uid,
          userData(request.auth.uid).elderId
        );
    }

    match /users/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role in ['caregiver', 'elder']
        && (request.resource.data.role != 'elder'
          || (request.resource.data.elderId.matches('^ELD-[A-Z0-9]{4,10}$')
            && ownsElderIdAfter(uid, request.resource.data.elderId)));
      allow read: if signedIn() && (
        request.auth.uid == uid
        || isAdmin()
        || canCaregiverAccessElderUser(uid, resource.data)
        || canElderAccessCaregiverUser(uid)
      );
      allow update: if isAdmin()
        || (signedIn()
          && request.auth.uid == uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status
          && request.resource.data.email == resource.data.email
          && request.resource.data.authProvider == resource.data.authProvider
          && request.resource.data.createdAt == resource.data.createdAt
          && (resource.data.role != 'elder'
            || request.resource.data.elderId == resource.data.elderId
            || (request.resource.data.elderId.matches('^ELD-[A-Z0-9]{4,10}$')
              && ownsElderIdAfter(uid, request.resource.data.elderId))));
      allow delete: if isAdmin();
    }

    match /elderIds/{elderId} {
      allow create: if signedIn()
        && !exists(elderIdPath(elderId))
        && request.resource.data.keys().hasAll([
          'elderUid',
          'elderId',
          'fullName',
          'status',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'elderUid',
          'elderId',
          'fullName',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.elderUid == request.auth.uid
        && request.resource.data.elderId == elderId
        && request.resource.data.status == 'active'
        && getAfter(userPath(request.auth.uid)).data.role == 'elder'
        && getAfter(userPath(request.auth.uid)).data.elderId == elderId;
      allow get: if signedIn();
      allow list: if isAdmin();
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.elderUid == request.auth.uid
          && request.resource.data.elderUid == resource.data.elderUid
          && request.resource.data.elderId == resource.data.elderId
          && request.resource.data.elderId == elderId
          && request.resource.data.status == resource.data.status
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'fullName',
            'createdAt',
            'updatedAt'
          ])
          && userExists(request.auth.uid)
          && userData(request.auth.uid).role == 'elder'
          && userData(request.auth.uid).elderId == elderId);
      allow delete: if isAdmin();
    }

    match /relationships/{relationshipId} {
      allow create: if signedIn()
        && isCaregiver()
        && request.resource.data.keys().hasAll([
          'id',
          'caregiverUid',
          'elderUid',
          'elderId',
          'status',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'id',
          'caregiverUid',
          'elderUid',
          'elderId',
          'status',
          'createdAt'
        ])
        && request.resource.data.id == relationshipId
        && request.resource.data.caregiverUid == request.auth.uid
        && request.resource.data.elderId.matches('^ELD-[A-Z0-9]{4,10}$')
        && relationshipId == 'rel-' + request.auth.uid + '-' + request.resource.data.elderId
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && isActiveElderId(
          request.resource.data.elderId,
          request.resource.data.elderUid
        );
      allow read: if signedIn() && (
        request.auth.uid == resource.data.caregiverUid
        || request.auth.uid == resource.data.elderUid
        || isAdmin()
      );
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['active', 'inactive'];
      allow delete: if isAdmin();
    }

    match /elders/{elderId} {
      allow read, write: if signedIn() && canAccessElder(elderId);

      match /{document=**} {
        allow read, write: if signedIn() && canAccessElder(elderId);
      }
    }

    match /AIReports/{reportId} {
      allow read, write: if signedIn() && canAccessElder(resource.data.residentId);
      allow create: if signedIn() && canAccessElder(request.resource.data.residentId);
    }
  }
}
